{
  "name": "cursor-ai-monitor",
  "displayName": "Cursor AI Monitor Pro",
  "description": "实时显示 Cursor AI 正在修改的文件 - 专业版（区分用户/Agent操作）",
  "version": "0.2.1",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-ai-monitor.toggleMode",
        "title": "AI Monitor: 切换监测模式"
      },
      {
        "command": "cursor-ai-monitor.startManual",
        "title": "AI Monitor: 开启手动监测模式"
      },
      {
        "command": "cursor-ai-monitor.stopMonitor",
        "title": "AI Monitor: 关闭监测（切回安全模式）"
      },
      {
        "command": "cursor-ai-monitor.toggleLog",
        "title": "AI Monitor: 显示/隐藏监测日志"
      },
      {
        "command": "cursor-ai-monitor.showLog",
        "title": "AI Monitor: 打开监测日志"
      },
      {
        "command": "cursor-ai-monitor.clearLog",
        "title": "AI Monitor: 清空日志"
      },
      {
        "command": "cursor-ai-monitor.reset",
        "title": "AI Monitor: 重置状态"
      }
    ],
    "keybindings": [
      {
        "command": "cursor-ai-monitor.toggleMode",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorTextFocus",
        "description": "切换 AI 监测模式"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.105.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
